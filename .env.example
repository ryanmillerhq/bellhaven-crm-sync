# Copy to .env and fill in. Never commit .env.
CRM_API_TOKEN=your-personal-token-here
# Supabase TRANSACTION pooler URI (port 6543): serverless/CI safe; the session pooler caps at 15 clients
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
CRM_BASE_URL=https://analyst-assessment-production.up.railway.app/api/v1
SITE_BASE_URL=https://analyst-assessment-production.up.railway.app
